# Copy to .env.local for development. Never commit real values.
# Production values go in Vercel > Project > Settings > Environment Variables.

# Canonical site URL (no trailing slash). Used for metadata, sitemap, OG, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form (Resend). Without a key the API returns 503 and the form shows a mailto fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=udaysankarobbu@gmail.com
# Must be a sender on a domain you verified in Resend (or onboarding@resend.dev for testing).
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Cloudflare Turnstile (optional but recommended). Leave blank to rely on the honeypot only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional cookieless analytics via Plausible (Vercel Analytics is always on when deployed to Vercel).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
